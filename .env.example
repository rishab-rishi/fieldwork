# Local Postgres (via `docker compose up -d`)
DATABASE_URL="postgresql://freelancer:freelancer_dev_password@localhost:5432/freelancer_portal?schema=public"

# NextAuth
# Generate one with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Local file uploads (dev only — outside /public, served through an authenticated route)
UPLOAD_DIR="./uploads"
